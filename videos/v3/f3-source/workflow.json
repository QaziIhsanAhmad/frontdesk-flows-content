{"name": "Harbourline Physio: enquiry dedupe", "settings": {"executionOrder": "v1", "saveManualExecutions": true, "saveDataSuccessExecution": "all"}, "nodes": [{"id": "a1", "name": "New enquiry", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [0, 300], "webhookId": "6b1e2c1a-f3de-4d00-9a11-dedupe000001", "parameters": {"httpMethod": "POST", "path": "enquiry-dedupe", "responseMode": "onReceived", "options": {}}}, {"id": "a2", "name": "Normalise contact", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [240, 300], "parameters": {"jsCode": "const b = $json.body;\nconst email = String(b.email || '').trim().toLowerCase();\nlet phone = String(b.phone || '').replace(/[^0-9+]/g, '');\nif (phone.startsWith('0')) phone = '+44' + phone.slice(1);\nif (phone.startsWith('44')) phone = '+' + phone;\nconst name = String(b.name || '').trim().replace(/\\s+/g, ' ');\nreturn [{ json: { name, email, phone, message: String(b.message || '').trim(), received: $now.toFormat('dd LLL HH:mm') } }];"}}, {"id": "a3", "name": "Find existing lead", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [480, 300], "parameters": {"url": "http://harbourlinephysio.test/api/leads", "sendQuery": true, "queryParameters": {"parameters": [{"name": "email", "value": "={{ $json.email }}"}, {"name": "phone", "value": "={{ $json.phone }}"}]}, "options": {}}}, {"id": "a4", "name": "Already a lead?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [720, 300], "parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2}, "conditions": [{"id": "c1", "leftValue": "={{ $json.found }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}}}, {"id": "a5", "name": "Add to existing lead", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [980, 180], "parameters": {"method": "POST", "url": "http://harbourlinephysio.test/api/leads/update", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ id: $json.lead.id, name: $('Normalise contact').item.json.name, phone: $('Normalise contact').item.json.phone, enquiry: { at: $('Normalise contact').item.json.received, message: $('Normalise contact').item.json.message } }) }}", "options": {}}}, {"id": "a6", "name": "Create new lead", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [980, 420], "parameters": {"method": "POST", "url": "http://harbourlinephysio.test/api/leads", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ name: $('Normalise contact').item.json.name, email: $('Normalise contact').item.json.email, phone: $('Normalise contact').item.json.phone, enquiry: { at: $('Normalise contact').item.json.received, message: $('Normalise contact').item.json.message } }) }}", "options": {}}}], "connections": {"New enquiry": {"main": [[{"node": "Normalise contact", "type": "main", "index": 0}]]}, "Normalise contact": {"main": [[{"node": "Find existing lead", "type": "main", "index": 0}]]}, "Find existing lead": {"main": [[{"node": "Already a lead?", "type": "main", "index": 0}]]}, "Already a lead?": {"main": [[{"node": "Add to existing lead", "type": "main", "index": 0}], [{"node": "Create new lead", "type": "main", "index": 0}]]}}, "active": false}