   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    200
   ],
   "parameters": {
    "jsCode": "// Kind tone: no guilt, no fees.\nconst b = $('Booking Updated').first().json.body; const s = $('Settings').first().json;\nconst first = b.name.split(' ')[0];\nconst text = `Hi ${first},\\n\\nWe missed you at your ${b.time} appointment today. No problem at all, these things happen.\\n\\nWould you like to rebook? You can pick a new time here: ${s.rebookLink}\\n\\n${s.signature}`;\nreturn [{ json: { to: b.email, name: b.name, subject: `We missed you today, ${first}`, text } }];"
   }
  },
  {
   "id": "decf21dd-7739-4c57-a7c2-0c84299ee118",
