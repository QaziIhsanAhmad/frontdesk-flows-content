   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    440,
    300
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "ae7c055e-c2f5-4c9f-b7ba-8a85362e9674",
       "leftValue": "={{ $json.body.status }}",
       "rightValue": "completed",
       "operator": {
        "type": "string",
        "operation": "equals"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "id": "c06ddea6-c45d-40f4-86df-d0b171152b4b",
   "name": "Write Thank-you",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    300
   ],
   "parameters": {
    "jsCode": "// Same message for EVERY patient: no filtering by happiness (no review gating).\nconst b = $('Visit Completed').first().json.body; const s = $('Settings').first().json;\nconst first = b.name.split(' ')[0];\nconst text = `Hi ${first},\\n\\nThanks for visiting ${s.businessName} today.\\n\\nIf you have a minute, we'd really appreciate a Google review: ${s.reviewLink}\\n\\nAnything we could do better? Tell us privately here: ${s.feedbackLink}\\n\\n${s.signature}`;\nreturn [{ json: { to: b.email, name: b.name, subject: `Thanks for visiting today, ${first}`, text } }];"
   }
  },
  {
   "id": "ba9858b7-06f6-407b-9a3c-02faed89cc1a",
   "name": "Email Every Patient",
   "type": "n8n-nodes-base.emailSend",
   "typeVersion": 2.1,
   "position": [
    880,
    300
   ],
   "parameters": {
    "fromEmail": "hello@harbourlinephysio.test",
    "toEmail": "={{ $json.to }}",
    "subject": "={{ $json.subject }}",
    "emailFormat": "text",
    "text": "={{ $json.text }}",
    "options": {
     "appendAttribution": false
    }
   },
   "credentials": {
    "smtp": {
     "id": "",
     "name": ""
    }
   }
  },
  {
   "id": "6135bade-6be6-4013-9d2e-4086017e7399",
